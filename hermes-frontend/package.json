{
  "name": "hermes-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=20.0.0", "npm": ">=9.0.0" },
  "scripts": {
    "dev": "vite",
    "check:no-quarter": "bash ../scripts/check-no-quarter.sh",
    "build": "npm run check:no-quarter && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.1",
    "axios": "^1.18.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-router": "^8.0.1",
    "react-router-dom": "^7.18.0",
    "styled-components": "^6.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "storybook": "^8.6.14",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  },
  "//overrides": "Storybook 8 嘅 peer 只支援 vite ^4||^5||^6，本 project 用 vite 8，所以 npm install 會 ERESOLVE 失敗。用 overrides 只對 Storybook 一條線破例（$vite = 上面 devDependencies 嘅 vite 版本），其餘 dependency tree 仍然有完整 peer 檢查 —— 比 --legacy-peer-deps 精準得多。Storybook 唔參與 npm run build，所以生產 build 不受影響。升到 Storybook 9 之後可以移除呢段。",
  "overrides": {
    "@storybook/react-vite": {
      "vite": "$vite"
    },
    "@storybook/builder-vite": {
      "vite": "$vite"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "vite": "$vite"
    }
  }
}
