# ╔══════════════════════════════════════════════════════╗
# ║  ClientRadar CMS — Frontend (.env)                  ║
# ║  複製此檔案為 .env 並填入實際值                        ║
# ║  cp .env.example .env                               ║
# ║  注意: Vite 只讀取 VITE_ 開頭的變數                   ║
# ╚══════════════════════════════════════════════════════╝

# ── Backend API 地址 ─────────────────────────────────
# 本地開發: http://localhost:4000/api
# UAT/生產: https://api.your-domain.com/api
VITE_API_URL=http://localhost:4000/api

# ── Push Notifications (可選) ────────────────────────
# VAPID public key，用於 Web Push 通知
# 如不需要推播通知可留空
# VITE_VAPID_PUBLIC_KEY=

# ── 開發用 (可選) ────────────────────────────────────
# 郵件佇列頁面的預設寄件人/測試收件人（僅開發用）
# VITE_SMTP_FROM=noreply@example.com
# VITE_TEST_RECIPIENT=test@example.com
