# ╔══════════════════════════════════════════════════════╗
# ║  ClientRadar CMS — Worker (.env)                    ║
# ║  複製此檔案為 .env 並填入實際值                        ║
# ║  cp .env.example .env                               ║
# ║  ⚠️ 需要 Node >= 20.6.0 (使用 --env-file 載入)      ║
# ╚══════════════════════════════════════════════════════╝

# ── MongoDB ──────────────────────────────────────────
# 必須與 cms/server 使用相同的 MongoDB
MONGODB_URI=mongodb://localhost:27017/lead_scraper

# ── CMS API 連線 ────────────────────────────────────
# Worker 透過 API 登入並 claim tasks
# ⚠️ API_URL 必須指向 Backend 的地址
API_URL=http://localhost:4000/api

# Worker 登入帳號（必須先在系統中建立此帳號）
# 首次部署請先用 seed script 建立，或手動註冊後填入
AGENT_EMAIL=admin@test.com
AGENT_PASS=123456

# Worker 識別碼（多 Worker 部署時每台須不同）
AGENT_ID=WORKER-1

# 輪詢間隔（毫秒）
POLL_MS=2000

# ── 測試收件人（開發環境用）──────────────────────────
# 開發時所有郵件發送至此地址，避免誤寄
TEST_RECIPIENT_EMAIL=your-email@example.com

# ── SMTP（Worker 直接發送用）─────────────────────────
# 注意: Worker 會優先使用每個使用者的個人 SMTP 設定
# 此處為 fallback（可選）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ClientRadar" <your-email@gmail.com>

# ── 並行度設定（可選）────────────────────────────────
# 每個 stage 的最大並行任務數，預設為 1
# S1_CONCURRENCY=1
# S2_CONCURRENCY=1
# S3_CONCURRENCY=1
# S4_CONCURRENCY=1
# RESTART_DELAY=5000
