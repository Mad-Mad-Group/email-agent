# ╔══════════════════════════════════════════════════════╗
# ║  ClientRadar CMS — Worker (.env)                    ║
# ║  複製此檔案為 .env 並填入實際值                        ║
# ║  cp .env.example .env                               ║
# ║  ⚠️ 需要 Node >= 20.6.0 (使用 --env-file 載入)      ║
# ╚══════════════════════════════════════════════════════╝

# ── MongoDB ──────────────────────────────────────────
# 必須與 cms/server 使用相同的 MongoDB
MONGODB_URI=mongodb://localhost:27017/lead_scraper

# ── CMS API 連線 ────────────────────────────────────
# Worker 透過 API 登入並 claim tasks
# ⚠️ API_URL 必須指向 Backend 的地址
API_URL=http://localhost:4000/api

# Worker 登入帳號（必須先在系統中建立此帳號）
# 首次部署請先用 seed script 建立，或手動註冊後填入
AGENT_EMAIL=admin@test.com
AGENT_PASS=123456

# Worker 識別碼（多 Worker 部署時每台須不同）
AGENT_ID=WORKER-1

# 輪詢間隔（毫秒）
POLL_MS=2000

# ── 測試收件人（開發環境用）──────────────────────────
# 開發時所有郵件發送至此地址，避免誤寄
TEST_RECIPIENT_EMAIL=your-email@example.com

# ── SMTP（Worker 直接發送用）─────────────────────────
# 注意: Worker 會優先使用每個使用者的個人 SMTP 設定
# 此處為 fallback（可選）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ClientRadar <your-email@gmail.com>"
# ── Hermes agent 位置 ───────────────────────────────
# 完整命令，空白分隔。以前寫死 'hermes'，即係 agent 必須同 worker 同一部機。
#   HERMES_CMD=hermes                          本機 PATH（預設）
#   HERMES_CMD=/opt/hermes/bin/hermes          本機但唔喺 PATH
#   HERMES_CMD=docker exec -i hermes hermes    喺容器內跑
# HERMES_CMD=hermes
#
# ── 遠端 hermes（另一部機）──────────────────────────
# hermes 唔喺 worker 同一部機？set 個 IP 就得，其他都有預設值：
# HERMES_HOST=192.168.1.104
# HERMES_USER=madmad                        預設 madmad
# HERMES_KEY=/home/madmad/.ssh/id_ed25519   可選，唔設就用 ssh 預設 key
# HERMES_REMOTE_BIN=$HOME/.local/bin/hermes 預設值。~/.local/bin 通常唔喺
#                                           非互動 shell 嘅 PATH，所以用絕對路徑
#
# 前置：worker 機 → hermes 機要做好 SSH key 免密碼。
# 註：ssh 唔保留 argv 邊界（會拼成一條字串交俾遠端 shell 重拆），所以 agent.ts
#     會自己 shell-quote 每個參數。呢件事全部喺 code 入面做，唔需要喺伺服器
#     放任何 script。詳見 agent.ts 嘅 hermesArgv()。

# ── API 額度警報（可選）─────────────────────────────
# 偵測到額度／限流字眼時，worker 會通知 CMS（再通知每個 admin + email）。
# 內建關鍵字已涵蓋 rate limit / quota / 429 / 額度 等；
# hermes CLI 換版本改咗字眼就喺呢度補，唔使改 code。逗號分隔。
# QUOTA_PATTERNS=some new wording,另一個字眼

# ── 並行度設定（可選）────────────────────────────────
# 呢啲只係 fallback —— 實際值由 CMS Settings → AI Agent → Concurrency 決定，
# worker 每 30 秒自動跟上，唔使重啟。
# S1_CONCURRENCY=3
# S2_CONCURRENCY=3
# S3_CONCURRENCY=3
# S4_CONCURRENCY=2
# CONCURRENCY_REFRESH_MS=30000
# RESTART_DELAY=5000
