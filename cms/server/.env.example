# ╔══════════════════════════════════════════════════════╗
# ║  ClientRadar CMS — Backend (.env)                   ║
# ║  複製此檔案為 .env 並填入實際值                        ║
# ║  cp .env.example .env                               ║
# ╚══════════════════════════════════════════════════════╝

# ── MongoDB ──────────────────────────────────────────
# 本地開發: mongodb://localhost:27017/lead_scraper
# 遠端/Atlas: mongodb+srv://user:pass@cluster.mongodb.net/lead_scraper
MONGODB_URI=mongodb://localhost:27017/lead_scraper

# ── JWT 認證 ─────────────────────────────────────────
# ⚠️ 必須修改！用於簽署 JWT token，建議使用隨機字串
#    產生方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-change-me

# Token 有效期 (例: 7d=7天, 1h=1小時, 30m=30分鐘)
JWT_EXPIRES_IN=7d

# ── Refresh Token 加密 ──────────────────────────────
# ⚠️ 必須修改！用於加密 refresh token
#    產生方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_TOKEN_KEY=your-refresh-token-key-change-me

# ── SMTP 郵件（系統級 fallback）────────────────────
# 注意: 使用者可在 Settings 頁面設定個人 SMTP
# 此處為系統級 fallback（可選）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ClientRadar <noreply@example.com>"
# ── Server ───────────────────────────────────────────
PORT=4000

# ── CORS ─────────────────────────────────────────────
# 留空: 允許 localhost + 內網 (192.168.x.x, 10.x.x.x :5173)
# 'url1,url2': 額外允許的 origin (例: http://192.168.1.50:5173)
# '__strict__': 生產環境 — 只允許 localhost
CORS_ORIGIN=

# ── Swagger (可選，開發用) ───────────────────────────
# SWAGGER_SERVER_URL=http://localhost:4000
# SWAGGER_EXPORT_JSON=true
# SWAGGER_EXPORT_PATH=./swagger.json
