# ╔══════════════════════════════════════════════════════╗
# ║  ClientRadar — 根目錄 .env（舊腳本/工具用）           ║
# ║  複製此檔案為 .env 並填入實際值                        ║
# ║  cp .env.example .env                               ║
# ║                                                      ║
# ║  ⚠️ 主要設定在各子目錄的 .env 中：                     ║
# ║     cms/server/.env  — Backend API                   ║
# ║     cms/worker/.env  — AI Worker                     ║
# ║     hermes-frontend/.env — Frontend                  ║
# ╚══════════════════════════════════════════════════════╝

# AI Agent LLM API Key
# 目前用 MiniMax，後續可能更換其他 provider
MINIMAX_API_KEY=sk-your-key-here

# SMTP（根目錄舊腳本使用，可選）
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-app-password
